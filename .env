# Application settings
APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=replace-with-secure-key

# PostgreSQL settings
POSTGRES_USER=webvory
POSTGRES_PASSWORD=webvory
POSTGRES_DB=webvory

# Redis settings
REDIS_HOST=redis
REDIS_PORT=6379

# SSL / domain
SSL_DOMAIN=

# Server deployment path for GitHub Actions
DEPLOY_PATH=/opt/webvory
